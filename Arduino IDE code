#include <ESP8266WiFi.h>
#include <DHT.h>

#define DHTPIN D4
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";
const char* server = "http://yourserver.com/upload.php";  // Replace with your domain or IP

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  dht.begin();

  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Connecting...");
  }
  Serial.println("Connected");
}

void loop() {
  float temp = dht.readTemperature();
  float hum = dht.readHumidity();

  if (isnan(temp) || isnan(hum)) {
    Serial.println("Failed to read from DHT sensor!");
    return;
  }

  // Create the URL
  String url = server + String("?temp=") + temp + "&hum=" + hum;

  WiFiClient client;
  if (client.connect("yourserver.com", 80)) {
    client.println("GET " + url + " HTTP/1.1");
    client.println("Host: yourserver.com");
    client.println("Connection: close");
    client.println();
  }

  delay(60000); // Wait 1 minute before sending again
}
