-- View sensor data for a user
SELECT * FROM Sensor_Data WHERE user_id = 1;

-- Average moisture level in past week
SELECT AVG(moisture_level) AS avg_moisture
FROM Sensor_Data
WHERE timestamp >= NOW() - INTERVAL 7 DAY;

-- List watering events
SELECT * FROM Watering_History WHERE user_id = 1 ORDER BY timestamp DESC;

-- Get recent notifications
SELECT * FROM Notifications WHERE user_id = 1 ORDER BY timestamp DESC LIMIT 5;
